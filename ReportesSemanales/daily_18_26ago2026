<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily CX · 18–26 ago 2026</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f6f5fa;--surface:#fff;--border:#e5e1f0;--text:#18151f;--text2:#635c7a;--text3:#a099b8;
  --sk:#7c3aed;--sf:#2563eb;--cel:#16a34a;
  --green:#059669;--green-bg:#ecfdf5;--green-border:#a7f3d0;
  --red:#dc2626;--red-bg:#fef2f2;--red-border:#fecaca;
  --amber:#d97706;--amber-bg:#fffbeb;--amber-border:#fde68a;
  --r:10px;
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);padding:2rem 1.25rem 4rem;font-size:14px;line-height:1.5}
.page{max-width:860px;margin:0 auto}

/* HEADER */
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:2px solid var(--border);flex-wrap:wrap;gap:.5rem}
.header-left{display:flex;flex-direction:column}
.eyebrow{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}
.header h1{font-size:22px;font-weight:300;letter-spacing:-.02em}
.header h1 strong{font-weight:600}
.header-date{font-size:12px;color:var(--text3)}

/* SEMAFORO */
.semaforo{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem}
.sem-card{border-radius:var(--r);padding:1rem 1.1rem;border:1px solid;position:relative;overflow:hidden}
.sem-card.red{background:var(--red-bg);border-color:var(--red-border)}
.sem-card.amber{background:var(--amber-bg);border-color:var(--amber-border)}
.sem-card.green{background:var(--green-bg);border-color:var(--green-border)}
.sem-brand{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-bottom:.3rem}
.sem-card.red .sem-brand{color:var(--red)}.sem-card.amber .sem-brand{color:var(--amber)}.sem-card.green .sem-brand{color:var(--cel)}
.sem-status{font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem;opacity:.8}
.sem-card.red .sem-status{color:var(--red)}.sem-card.amber .sem-status{color:var(--amber)}.sem-card.green .sem-status{color:var(--cel)}
.sem-stats{display:flex;flex-direction:column;gap:3px}
.sem-stat{font-size:11px;color:var(--text2);display:flex;justify-content:space-between}
.sem-stat span{font-weight:500;color:var(--text)}
.sem-stat span.red{color:var(--red)}.sem-stat span.green{color:var(--green)}.sem-stat span.amber{color:var(--amber)}

/* ACCIONES */
.acciones{margin-bottom:1.25rem}
.acc-title{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);margin-bottom:.6rem}
.acc-list{display:flex;flex-direction:column;gap:6px}
.acc{border-radius:8px;padding:.7rem 1rem;border:1px solid;font-size:12.5px;display:flex;align-items:flex-start;gap:10px;line-height:1.5}
.acc.red{background:var(--red-bg);border-color:var(--red-border);color:#7f1d1d}
.acc.amber{background:var(--amber-bg);border-color:var(--amber-border);color:#92400e}
.acc.green{background:var(--green-bg);border-color:var(--green-border);color:#065f46}
.acc-icon{font-size:15px;flex-shrink:0;margin-top:1px}
.acc-body strong{display:block;font-weight:600;margin-bottom:2px}

/* GRAFICOS */
.charts-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.25rem}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1rem 1.1rem}
.chart-title{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}

/* RESENAS */
.resenas-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.25rem}
.res-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1rem 1.1rem}
.res-title{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.res-kpis{display:flex;gap:12px;margin-bottom:.75rem}
.res-kpi{text-align:center}
.res-kpi-val{font-size:22px;font-weight:300;line-height:1}
.res-kpi-val.green{color:var(--green)}.res-kpi-val.red{color:var(--red)}.res-kpi-val.sk{color:var(--sk)}.res-kpi-val.sf{color:var(--sf)}
.res-kpi-label{font-size:10px;color:var(--text3)}
.res-sep{width:1px;background:var(--border);align-self:stretch}
.res-highlight{border-radius:6px;padding:.55rem .8rem;font-size:11.5px;border:1px solid;line-height:1.45;margin-bottom:5px}
.res-highlight.red{background:var(--red-bg);border-color:var(--red-border);color:#7f1d1d}
.res-highlight.green{background:var(--green-bg);border-color:var(--green-border);color:#065f46}
.res-highlight.amber{background:var(--amber-bg);border-color:var(--amber-border);color:#92400e}
.res-highlight strong{display:block;margin-bottom:2px}

/* BURBUXA */
.burb-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1rem 1.1rem;margin-bottom:1.25rem}
.burb-title{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.burb-kpis{display:flex;gap:0;margin-bottom:.75rem}
.burb-kpi{flex:1;text-align:center;padding:.5rem;border-right:1px solid var(--border)}
.burb-kpi:last-child{border-right:none}
.burb-kpi-val{font-size:22px;font-weight:300;line-height:1;margin-bottom:2px}
.burb-kpi-val.green{color:var(--green)}.burb-kpi-val.sk{color:var(--sk)}.burb-kpi-val.red{color:var(--red)}.burb-kpi-val.amber{color:var(--amber)}
.burb-kpi-label{font-size:10px;color:var(--text3);line-height:1.3}

.footer{text-align:center;font-size:11px;color:var(--text3);margin-top:3rem}
@media(max-width:600px){.semaforo,.charts-row,.resenas-row{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="page">

<!-- HEADER -->
<div class="header">
  <div class="header-left">
    <div class="eyebrow">Laboratorio BEK · CX</div>
    <h1><strong>Daily</strong> · semana 18–26 agosto 2026</h1>
  </div>
  <div class="header-date">7 días hábiles</div>
</div>

<!-- SEMAFORO -->
<div class="semaforo">
  <div class="sem-card red">
    <div class="sem-brand">🔵 SkinFree</div>
    <div class="sem-status">🔴 Crítico</div>
    <div class="sem-stats">
      <div class="sem-stat">WPP atendidos <span class="red">1 ⚠️ WPP bloqueado</span></div>
      <div class="sem-stat">Días en 0 <span class="red">0 de 7</span></div>
      <div class="sem-stat">Mails atendidos <span class="amber">30 (canal alternativo)</span></div>
      <div class="sem-stat">Pend. al 25/ago cierre <span class="red">>190 · 26/ago sin dato</span></div>
    </div>
  </div>
  <div class="sem-card green">
    <div class="sem-brand">🟣 Skinko</div>
    <div class="sem-status">🟢 En orden</div>
    <div class="sem-stats">
      <div class="sem-stat">WPP atendidos <span class="green">137</span></div>
      <div class="sem-stat">Días en 0 <span class="green">2 de 7</span></div>
      <div class="sem-stat">Mails atendidos <span class="green">294</span></div>
      <div class="sem-stat">Pend. prom. cierre <span class="green">~5</span></div>
    </div>
  </div>
  <div class="sem-card green">
    <div class="sem-brand">🟢 Celimax</div>
    <div class="sem-status">🟢 En orden</div>
    <div class="sem-stats">
      <div class="sem-stat">WPP atendidos <span class="green">46</span></div>
      <div class="sem-stat">Días en 0 <span class="green">4 de 7</span></div>
      <div class="sem-stat">Mails atendidos <span class="green">65</span></div>
      <div class="sem-stat">Pend. prom. cierre <span class="green">~1</span></div>
    </div>
  </div>
</div>

<!-- ACCIONES URGENTES -->
<div class="acciones">
  <div class="acc-title">⚡ Requiere acción</div>
  <div class="acc-list">
    <div class="acc red">
      <div class="acc-icon">🔴</div>
      <div class="acc-body"><strong>SkinFree WPP bloqueado · >190 pendientes sin resolver</strong>El canal sigue sin activarse al 26/ago. Mientras no se reactive, toda la atención pasa por mail. Clientes sin respuesta = riesgo de más reclamos en Google.</div>
    </div>
    <div class="acc red">
      <div class="acc-icon">⚠️</div>
      <div class="acc-body"><strong>Google SkinFree · Ariela Perdiechizi · reclamo Defensa del Consumidor</strong>Publicó hace 1 día. Sin respuesta. WPP eliminado según ella. Requiere respuesta en Google Maps hoy y gestión del pedido.</div>
    </div>
    <div class="acc red">
      <div class="acc-icon">🏪</div>
      <div class="acc-body"><strong>Skinko DOT · asesoramiento incorrecto · rosácea</strong>Clienta con rosácea declarada recibió producto para acné. Causó daño real (ardor, resecamiento). Seguimiento con el equipo DOT esta semana.</div>
    </div>
    <div class="acc amber">
      <div class="acc-icon">📚</div>
      <div class="acc-body"><strong>Skinko Alto Palermo · patrón "no sé" · 3 reseñas negativas en 7 días</strong>Analía Jazmín (cosmiatra), Jon Arnold y Florencia Aref — todos mencionan falta de conocimiento técnico. Carla, Julieta y Florencia son las asesoras de alto rendimiento; el gap está en el resto del equipo.</div>
    </div>
  </div>
</div>

<!-- BURBUXA SK -->
<div class="burb-card" style="padding:0;overflow:hidden">
  <div style="display:grid;grid-template-columns:1fr 1fr">
    <!-- SK -->
    <div style="padding:1rem;border-right:1px solid var(--border)">
      <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--sk);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)">🟣 Burbuxa Skinko · 18–26/ago</div>
      <div style="display:flex;flex-direction:column;gap:.5rem">
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Tickets</span><span style="font-weight:600;color:var(--sk)">1.184</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">IA resuelve sola</span><span style="font-weight:600;color:var(--green)">75.3%</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Reabiertos</span><span style="font-weight:600;color:var(--amber)">34.8%</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Backlog abierto</span><span style="font-weight:600;color:var(--amber)">313 (9.6d)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Resp. humana</span><span style="font-weight:600;color:var(--green)">1.1h (p90: 17h)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-top:.25rem;padding-top:.5rem;border-top:1px solid var(--border)"><span style="color:var(--text3)">📅 Día pico</span><span style="font-weight:600;color:var(--text)">Martes (307 tickets)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">🕕 Hora pico</span><span style="font-weight:600;color:var(--text)">18:00 (111 tickets)</span></div>
      </div>
    </div>
    <!-- SF -->
    <div style="padding:1rem">
      <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--sf);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)">🔵 Burbuxa SkinFree · 18–26/ago ⚠️ WPP bloqueado</div>
      <div style="display:flex;flex-direction:column;gap:.5rem">
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Tickets</span><span style="font-weight:600;color:var(--sf)">523</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">IA resuelve sola</span><span style="font-weight:600;color:var(--green)">68.3%</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Reabiertos</span><span style="font-weight:600;color:var(--green)">32.1%</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Backlog abierto</span><span style="font-weight:600;color:var(--amber)">113 (9d)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">Resp. humana</span><span style="font-weight:600;color:var(--amber)">4h (p90: 22h)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-top:.25rem;padding-top:.5rem;border-top:1px solid var(--border)"><span style="color:var(--text3)">📅 Día pico</span><span style="font-weight:600;color:var(--text)">Martes (130 tickets)</span></div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--text3)">🕐 Hora pico</span><span style="font-weight:600;color:var(--text)">13:00 (60 tickets)</span></div>
      </div>
    </div>
  </div>
</div>

<!-- GRÁFICOS DE TÓPICOS -->
<div class="charts-row">
  <div class="chart-card">
    <div class="chart-title">Tópicos etiquetados · Skinko Burbuxa · agosto acumulado</div>
    <canvas id="chartTopSK" height="200"></canvas>
    <p style="font-size:10px;color:var(--text3);margin-top:.5rem">Solo tickets con etiqueta (30–40% del total). El 60–70% no tiene etiqueta asignada.</p>
  </div>
  <div class="chart-card">
    <div class="chart-title">Tópicos · SkinFree Burbuxa · semana 18–26/ago</div>
    <canvas id="chartTopSF" height="200"></canvas>
    <p style="font-size:10px;color:var(--text3);margin-top:.5rem">Top tópicos etiquetados. "Sin etiqueta" = 229 tickets no clasificados.</p>
  </div>
</div>

<!-- RESEÑAS -->
<div class="acciones">
  <div class="acc-title">⭐ Reseñas · highlights de la semana</div>
</div>
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.25rem">

  <div class="res-card">
    <div class="res-title">🟣 Skinko · Google + Judge.me</div>
    <div class="res-kpis">
      <div class="res-kpi"><div class="res-kpi-val green">7</div><div class="res-kpi-label">Google pos.</div></div>
      <div class="res-sep"></div>
      <div class="res-kpi"><div class="res-kpi-val red">4</div><div class="res-kpi-label">Google neg.</div></div>
      <div class="res-sep"></div>
      <div class="res-kpi"><div class="res-kpi-val sk">122</div><div class="res-kpi-label">JM nuevas</div></div>
      <div class="res-sep"></div>
      <div class="res-kpi"><div class="res-kpi-val green">78%</div><div class="res-kpi-label">JM pos.</div></div>
    </div>
    <div class="res-highlight red"><strong>🔴 AP · patrón "no sé" · 3 reseñas</strong>Analía, Jon Arnold, Florencia Aref. Capacitar al resto.</div>
    <div class="res-highlight red"><strong>🔴 DOT · rosácea · daño real · acción urgente</strong></div>
    <div class="res-highlight green"><strong>🟢 Berenice DOT (3x) · Avellaneda 0 negativos ✅</strong></div>
    <div class="res-highlight amber"><strong>🟡 JM · 11% neg. · expectativas vs. videos</strong></div>
  </div>

  <div class="res-card">
    <div class="res-title">🔵 SkinFree · Google</div>
    <div class="res-kpis">
      <div class="res-kpi"><div class="res-kpi-val green">13</div><div class="res-kpi-label">positivas</div></div>
      <div class="res-sep"></div>
      <div class="res-kpi"><div class="res-kpi-val red">1</div><div class="res-kpi-label">neg. urgente</div></div>
    </div>
    <div class="res-highlight green"><strong>💪 Envío rápido · 8 de 14 reseñas</strong></div>
    <div class="res-highlight red"><strong>🔴 Ariela Perdiechizi · Defensa del Consumidor</strong>Sin respuesta. Acción hoy en Google Maps.</div>
  </div>

  <div class="res-card">
    <div class="res-title">🟢 Celimax · Judge.me</div>
    <div class="res-kpis">
      <div class="res-kpi"><div class="res-kpi-val green">15</div><div class="res-kpi-label">reseñas</div></div>
      <div class="res-sep"></div>
      <div class="res-kpi"><div class="res-kpi-val green">100%</div><div class="res-kpi-label">positivas ✅</div></div>
    </div>
    <div class="res-highlight green"><strong>⭐ Vita-A Retinal · 8 de 15 reseñas</strong></div>
    <div class="res-highlight green"><strong>🟢 0 negativos · 0 neutras · semana perfecta</strong></div>
  </div>

</div>
<div class="footer">Daily CX · 18–26 agosto 2026 · Laboratorio BEK</div>
</div>

<script>
new Chart(document.getElementById('chartTopSK'), {
  type: 'bar',
  data: {
    labels: ['Importante/Escalada','Web Envíos','Cambio','Cancelación','Cupón','Error email','OCA/Reenvíos','Otros'],
    datasets: [{
      data: [128, 64, 63, 49, 45, 34, 31, 44],
      backgroundColor: ['#7c3aed','#2563eb','#16a34a','#059669','#d97706','#dc2626','#0891b2','#a099b8'],
      borderRadius: 4,
      borderWidth: 0
    }]
  },
  options: {
    indexAxis: 'y',
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: '#f0eef8' }, ticks: { font: { size: 10 } } },
      y: { grid: { display: false }, ticks: { font: { size: 10 } } }
    }
  }
});

new Chart(document.getElementById('chartTopSF'), {
  type: 'bar',
  data: {
    labels: ['Web Envíos','Web','Web Pagos','Error Pedido','Cambio','Error mail','Faltante','Falla','Reintegro'],
    datasets: [{
      data: [154, 81, 55, 53, 40, 27, 24, 20, 20],
      backgroundColor: ['#2563eb','#7c3aed','#0891b2','#dc2626','#16a34a','#d97706','#059669','#f59e0b','#6366f1'],
      borderRadius: 4,
      borderWidth: 0
    }]
  },
  options: {
    indexAxis: 'y',
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: '#f0eef8' }, ticks: { font: { size: 10 } } },
      y: { grid: { display: false }, ticks: { font: { size: 10 } } }
    }
  }
});
</script>
</body>
</html>
