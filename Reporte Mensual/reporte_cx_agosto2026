<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporte Mensual Agosto 2026 · Laboratorio BEK</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f6f5fa;--surface:#fff;--surface2:#f0eef8;--border:#e5e1f0;--border2:#cdc7e5;
  --text:#18151f;--text2:#635c7a;--text3:#a099b8;
  --sk:#6d28d9;--sk-mid:#7c3aed;--sk-light:#ede9fe;--sk-dim:rgba(124,58,237,.08);--sk-border:#c4b5fd;
  --sf:#1d4ed8;--sf-mid:#2563eb;--sf-light:#eff6ff;--sf-dim:rgba(37,99,235,.08);--sf-border:#bfdbfe;
  --cel:#15803d;--cel-mid:#16a34a;--cel-light:#f0fdf4;--cel-dim:rgba(34,197,94,.08);--cel-border:#bbf7d0;
  --green:#059669;--green-bg:#ecfdf5;--green-border:#a7f3d0;
  --red:#dc2626;--red-bg:#fef2f2;--red-border:#fecaca;
  --amber:#d97706;--amber-bg:#fffbeb;--amber-border:#fde68a;
  --r:10px;
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);padding:2.5rem 1.5rem 5rem;font-size:14px;line-height:1.5}
.page{max-width:980px;margin:0 auto}

/* HEADER */
.header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1.5px solid var(--border);flex-wrap:wrap;gap:1rem}
.header h1{font-size:26px;font-weight:300;letter-spacing:-.02em}
.header h1 strong{font-weight:600}
.eyebrow{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-bottom:6px}
.header-meta{font-size:12px;color:var(--text3);text-align:right;line-height:1.9}

/* GLOSARIO */
details.glosario{margin-bottom:1.5rem}
details.glosario summary{cursor:pointer;font-size:12px;font-weight:500;color:var(--text3);letter-spacing:.05em;text-transform:uppercase;padding:.5rem 0;list-style:none;display:flex;align-items:center;gap:6px}
details.glosario summary::-webkit-details-marker{display:none}
details.glosario summary::before{content:'▸ '}
details[open].glosario summary::before{content:'▾ '}
.glosario-body{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:.75rem 0}
.glos-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:.7rem 1rem;font-size:12px}
.glos-term{font-weight:600;color:var(--text);margin-bottom:3px}
.glos-def{color:var(--text2);line-height:1.5}

/* RESUMEN GENERAL */
.sec-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:1.5rem}
.brand-summary{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.brand-summary-header{padding:.85rem 1.1rem;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#fff}
.brand-summary-header.sk{background:var(--sk-mid)}.brand-summary-header.sf{background:var(--sf-mid)}.brand-summary-header.cel{background:var(--cel-mid)}
.brand-summary-body{padding:1rem 1.1rem}
.bs-main{font-size:36px;font-weight:300;line-height:1;margin-bottom:2px}
.bs-main.sk{color:var(--sk-mid)}.bs-main.sf{color:var(--sf-mid)}.bs-main.cel{color:var(--cel-mid)}
.bs-main-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:12px}
.bs-row{display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--border)}
.bs-row:last-child{border-bottom:none}
.bs-label{font-size:11px;color:var(--text3)}
.bs-val{font-size:14px;font-weight:500;color:var(--text)}
.bs-val.sk{color:var(--sk-mid)}.bs-val.sf{color:var(--sf-mid)}.bs-val.cel{color:var(--cel-mid)}.bs-val.grn{color:var(--green)}.bs-val.amber{color:var(--amber)}.bs-val.red{color:var(--red)}

/* ALERTAS */
.alertas-bloque{margin-bottom:2rem}
.alerta-item{margin-bottom:6px}
.alerta-item summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:.7rem 1rem;font-size:12.5px;font-weight:500}
.alerta-item summary::-webkit-details-marker{display:none}
.alerta-item summary .arr{margin-left:auto;font-size:10px;color:var(--text3)}
details[open].alerta-item summary .arr{transform:rotate(180deg)}
.alerta-item summary .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.alerta-item.red summary{border-color:var(--red-border);background:var(--red-bg);color:#7f1d1d}
.alerta-item.red summary .dot{background:var(--red)}
.alerta-item.amber summary{border-color:var(--amber-border);background:var(--amber-bg);color:#92400e}
.alerta-item.amber summary .dot{background:var(--amber)}
.alerta-item.green summary{border-color:var(--green-border);background:var(--green-bg);color:#065f46}
.alerta-item.green summary .dot{background:var(--green)}
.alerta-item.sk summary{border-color:var(--sk-border);background:var(--sk-dim);color:var(--sk)}
.alerta-item.sk summary .dot{background:var(--sk-mid)}
.alerta-body{padding:.75rem 1rem;font-size:12px;color:var(--text2);line-height:1.6;border:1px solid var(--border);border-top:none;border-radius:0 0 8px 8px;background:var(--surface)}
.alerta-item.red .alerta-body{border-color:var(--red-border);background:var(--red-bg);color:#7f1d1d}
.alerta-item.amber .alerta-body{border-color:var(--amber-border);background:var(--amber-bg);color:#92400e}
.alerta-item.green .alerta-body{border-color:var(--green-border);background:var(--green-bg);color:#065f46}
.alerta-item.sk .alerta-body{border-color:var(--sk-border);background:var(--sk-dim);color:var(--sk)}

/* TABS PRINCIPALES */
.tabs-bar{display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:2rem}
.tab-btn{padding:11px 20px;font-size:13px;font-weight:500;font-family:'Inter',sans-serif;background:none;border:none;border-bottom:3px solid transparent;margin-bottom:-2px;cursor:pointer;color:var(--text3);transition:color .15s,border-color .15s;white-space:nowrap}
.tab-btn.active{color:var(--text);border-bottom-color:var(--sk-mid)}
.tab-btn:hover:not(.active){color:var(--text2)}
.tab-panel{display:none}.tab-panel.active{display:block}

/* BRAND TABS dentro de panel */
.brand-tabs{display:flex;gap:6px;margin-bottom:1.5rem;flex-wrap:wrap}
.brand-btn{padding:7px 18px;font-size:12px;font-weight:500;font-family:'Inter',sans-serif;border-radius:20px;border:1px solid var(--border2);background:var(--surface);color:var(--text2);cursor:pointer;transition:all .15s}
.brand-btn.sk.active{background:var(--sk-light);color:var(--sk);border-color:var(--sk-border)}
.brand-btn.sf.active{background:var(--sf-light);color:var(--sf);border-color:var(--sf-border)}
.brand-btn.cel.active{background:var(--cel-light);color:var(--cel);border-color:var(--cel-border)}
.brand-panel{display:none}.brand-panel.active{display:block}

/* KPI */
.kpi-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.2rem}
.kpi-strip.cols2{grid-template-columns:repeat(2,1fr)}
.kpi-strip.cols3{grid-template-columns:repeat(3,1fr)}
.kpi-strip.cols5{grid-template-columns:repeat(5,1fr)}
.kpi{background:var(--surface);border:1px solid var(--border);border-top:3px solid var(--border2);border-radius:var(--r);padding:1rem 1.1rem}
.kpi.sk{border-top-color:var(--sk-mid)}.kpi.sf{border-top-color:var(--sf-mid)}.kpi.cel{border-top-color:var(--cel-mid)}
.kpi.grn{border-top-color:var(--green)}.kpi.red{border-top-color:var(--red)}.kpi.amb{border-top-color:var(--amber)}
.kpi-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
.kpi-val{font-size:30px;font-weight:300;color:var(--text);line-height:1;margin-bottom:3px}
.kpi-val.sk{color:var(--sk-mid)}.kpi-val.sf{color:var(--sf-mid)}.kpi-val.cel{color:var(--cel-mid)}
.kpi-val.grn{color:var(--green)}.kpi-val.red{color:var(--red)}.kpi-val.amb{color:var(--amber)}
.kpi-sub{font-size:11px;color:var(--text3)}

/* CARD */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1.2rem 1.3rem;margin-bottom:12px}
.card-title{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin-bottom:1rem;padding-bottom:.7rem;border-bottom:1px solid var(--border)}
.note{font-size:11px;color:var(--text3);margin-top:.6rem;line-height:1.5}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}

/* INLINE ALERT */
.inline-alert{border-radius:8px;padding:.7rem 1rem;font-size:12px;border:1px solid;margin-bottom:.75rem;line-height:1.5}
.inline-alert.warn{background:var(--amber-bg);border-color:var(--amber-border);color:#92400e}
.inline-alert.info{background:var(--sf-dim);border-color:var(--sf-border);color:var(--sf)}
.inline-alert.ok{background:var(--green-bg);border-color:var(--green-border);color:#065f46}
.inline-alert.sk{background:var(--sk-dim);border-color:var(--sk-border);color:var(--sk)}

/* HBAR */
.hbar-list{display:flex;flex-direction:column;gap:10px}
.hbar-header{display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px}
.hbar-name{color:var(--text2)}.hbar-count{font-weight:500;color:var(--text)}
.hbar-track{background:var(--surface2);border-radius:3px;height:6px;overflow:hidden}
.hbar-fill{height:6px;border-radius:3px}
.hbar-fill.sk{background:var(--sk-mid)}.hbar-fill.sf{background:var(--sf-mid)}.hbar-fill.cel{background:var(--cel-mid)}
.hbar-fill.amber{background:var(--amber)}.hbar-fill.grn{background:var(--green)}
.hbar-fill.c1{background:#7c3aed}.hbar-fill.c2{background:#2563eb}.hbar-fill.c3{background:#16a34a}
.hbar-fill.c4{background:#d97706}.hbar-fill.c5{background:#dc2626}.hbar-fill.c6{background:#0891b2}
.hbar-fill.c7{background:#7c3aed90}.hbar-fill.c8{background:#059669}

/* DATA TABLE */
.data-table{width:100%;border-collapse:collapse;font-size:12px}
.data-table th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);font-weight:500;padding:.5rem .7rem;border-bottom:1px solid var(--border)}
.data-table td{padding:.5rem .7rem;border-bottom:1px solid var(--border);color:var(--text2)}
.data-table tr:last-child td{border-bottom:none}
.data-table tr.today td{background:var(--surface2);font-weight:500;color:var(--text)}
.badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:500}
.badge.green{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}
.badge.amber{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber-border)}
.badge.red{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}
.badge.sk{background:var(--sk-light);color:var(--sk);border:1px solid var(--sk-border)}
.badge.sf{background:var(--sf-light);color:var(--sf);border:1px solid var(--sf-border)}

.val-green{color:var(--green);font-weight:500}
.val-red{color:var(--red);font-weight:500}
.val-amber{color:var(--amber);font-weight:500}
.val-sk{color:var(--sk-mid);font-weight:500}
.val-sf{color:var(--sf-mid);font-weight:500}
.val-cel{color:var(--cel-mid);font-weight:500}

/* ITEM */
.item-list{display:flex;flex-direction:column;gap:8px}
.item{border-radius:8px;padding:.8rem 1rem;border:1px solid}
.item.issue{background:var(--red-bg);border-color:var(--red-border)}
.item.ok{background:var(--green-bg);border-color:var(--green-border)}
.item.warn{background:var(--amber-bg);border-color:var(--amber-border)}
.item.sk{background:var(--sk-dim);border-color:var(--sk-border)}
.item.sf{background:var(--sf-dim);border-color:var(--sf-border)}
.item.cel{background:var(--cel-dim);border-color:var(--cel-border)}
.item-title{font-size:12.5px;font-weight:500;margin-bottom:3px}
.item.issue .item-title{color:var(--red)}.item.ok .item-title{color:var(--green)}
.item.warn .item-title{color:var(--amber)}.item.sk .item-title{color:var(--sk-mid)}
.item.sf .item-title{color:var(--sf-mid)}.item.cel .item-title{color:var(--cel-mid)}
.item-desc{font-size:12px;color:var(--text2);line-height:1.5}

/* CONTINGENCIA CHIPS */
.conting-list{display:flex;flex-direction:column;gap:8px}
.conting-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:.75rem 1rem;display:flex;align-items:flex-start;gap:10px;font-size:12.5px}
.conting-item.bloqueo{border-color:var(--red-border);background:var(--red-bg)}
.conting-item.plat{border-color:var(--amber-border);background:var(--amber-bg)}
.conting-item.daily{border-color:var(--border2);background:var(--surface2)}
.conting-item.logistica{border-color:var(--sf-border);background:var(--sf-dim)}
.chip{font-size:10px;font-weight:600;padding:2px 8px;border-radius:10px;white-space:nowrap;margin-top:1px}
.chip.sk{background:var(--sk-light);color:var(--sk);border:1px solid var(--sk-border)}
.chip.sf{background:var(--sf-light);color:var(--sf);border:1px solid var(--sf-border)}
.chip.cel{background:var(--cel-light);color:var(--cel);border:1px solid var(--cel-border)}
.chip.red{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}
.conting-date{font-weight:600;color:var(--text);min-width:40px}
.conting-desc{color:var(--text2);flex:1;line-height:1.5}
.chips-row{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:4px}

/* RESEÑAS EMBED */
.resenas-frame{width:100%;border:none;border-radius:var(--r);overflow:hidden}

/* COMPARATIVA RESEÑAS */
.resena-comp{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}
.rc-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1rem 1.1rem;text-align:center}
.rc-brand{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}
.rc-brand.sk{color:var(--sk-mid)}.rc-brand.sf{color:var(--sf-mid)}.rc-brand.cel{color:var(--cel-mid)}
.rc-rating{font-size:28px;font-weight:300;line-height:1}
.rc-rating.sk{color:var(--sk-mid)}.rc-rating.sf{color:var(--sf-mid)}.rc-rating.cel{color:var(--cel-mid)}
.rc-sub{font-size:11px;color:var(--text3);margin-top:4px}
.rc-row{display:flex;justify-content:space-between;font-size:11px;margin-top:8px;padding-top:6px;border-top:1px solid var(--border)}
.rc-row-label{color:var(--text3)}.rc-row-val{font-weight:500;color:var(--text)}

/* MV CARDS */
.mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:.75rem}
.mv-card{border-radius:8px;padding:.85rem 1rem;border:1px solid}
.mv-card.sk{background:var(--sk-dim);border-color:var(--sk-border)}
.mv-card.sf{background:var(--sf-dim);border-color:var(--sf-border)}
.mv-card.red{background:var(--red-bg);border-color:var(--red-border)}
.mv-card.warn{background:var(--amber-bg);border-color:var(--amber-border)}
.mv-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px}
.mv-card.sk .mv-label{color:var(--sk)}.mv-card.sf .mv-label{color:var(--sf)}
.mv-card.red .mv-label{color:var(--red)}.mv-card.warn .mv-label{color:var(--amber)}
.mv-val{font-size:20px;font-weight:300;line-height:1.1;margin-bottom:3px}
.mv-card.sk .mv-val{color:var(--sk-mid)}.mv-card.sf .mv-val{color:var(--sf-mid)}
.mv-card.red .mv-val{color:var(--red)}.mv-card.warn .mv-val{color:var(--amber)}
.mv-sub{font-size:11px;color:var(--text2)}

.footer{margin-top:4rem;text-align:center;font-size:11px;color:var(--text3);letter-spacing:.04em}
@media(max-width:660px){.kpi-strip,.kpi-strip.cols3,.kpi-strip.cols5{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}.summary-grid,.resena-comp{grid-template-columns:1fr}.header h1{font-size:20px}.glosario-body{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="page">

<!-- HEADER -->
<div class="header">
  <div>
    <div class="eyebrow">Laboratorio BEK · CX</div>
    <h1><strong>Reporte Mensual</strong> · Agosto 2026</h1>
  </div>
  <div class="header-meta">3 – 26 agosto 2026<br>Datos parciales hasta 26/08</div>
</div>

<!-- GLOSARIO -->
<details class="glosario">
  <summary>Glosario de términos</summary>
  <div class="glosario-body">
    <div class="glos-item"><div class="glos-term">Atendidos WPP</div><div class="glos-def">Bajadas reales del backlog intradía en WhatsApp: MAX(0, 9hs−18hs) + nuevos respondidos. No incluye tickets de Burbuxa.</div></div>
    <div class="glos-item"><div class="glos-term">Backlog / Pendientes</div><div class="glos-def">Mensajes sin responder al abrir (9hs) o al cerrar (18hs). Cuando la línea llega a 0, se vació la bandeja ese día.</div></div>
    <div class="glos-item"><div class="glos-term">Tickets Burbuxa (Todos)</div><div class="glos-def">Acumulado agosto en Burbuxa. El 25/08 el contador SK se reinició (3.600→53), los datos se leen en contexto.</div></div>
    <div class="glos-item"><div class="glos-term">Sin leer (Burbuxa)</div><div class="glos-def">Tickets que el bot archivó pero no fueron revisados por el equipo humano. Alta cantidad = demanda no resuelta.</div></div>
    <div class="glos-item"><div class="glos-term">Resueltos por IA</div><div class="glos-def">Tickets que Burbuxa cerró sin intervención humana. Un reopen rate alto indica que el bot cierra sin resolver de verdad.</div></div>
    <div class="glos-item"><div class="glos-term">Cotizaciones / Reenvíos OCA</div><div class="glos-def">Consultas por envíos demorados o perdidos con OCA. Requieren revisión manual en el panel del courier.</div></div>
    <div class="glos-item"><div class="glos-term">Merchant Voice</div><div class="glos-def">Función de Burbuxa que detecta riesgo de pérdida de cliente y puede disparar alertas o campañas de retención.</div></div>
    <div class="glos-item"><div class="glos-term">📊 Dato estimado</div><div class="glos-def">Días donde muchos chats no aparecían en WPP pero sí en Burbuxa. El dato de atendidos puede estar subestimado.</div></div>
  </div>
</details>

<!-- RESUMEN GENERAL -->
<div class="sec-label">Resumen general · agosto 2026 · comparativa 3 marcas</div>
<div class="summary-grid">
  <div class="brand-summary">
    <div class="brand-summary-header sk">🟣 Skinko</div>
    <div class="brand-summary-body">
      <div class="bs-main sk">420</div>
      <div class="bs-main-label">Chats WPP atendidos · prom. 25/día · máx. 69</div>
      <div class="bs-row"><span class="bs-label">Días bandeja en 0</span><span class="bs-val grn">4</span></div>
      <div class="bs-row"><span class="bs-label">Pend. prom. al cierre</span><span class="bs-val">~12</span></div>
      <div class="bs-row"><span class="bs-label">Mails atendidos</span><span class="bs-val">631 · ~49/día</span></div>
      <div class="bs-row"><span class="bs-label">Tópico principal WPP</span><span class="bs-val">Envíos / Web</span></div>
      <div class="bs-row"><span class="bs-label">Tickets Burbuxa</span><span class="bs-val sk">3.286</span></div>
      <div class="bs-row"><span class="bs-label">IA resuelve sola</span><span class="bs-val grn">72% prom. ↑</span></div>
    </div>
  </div>
  <div class="brand-summary">
    <div class="brand-summary-header sf">🔵 SkinFree</div>
    <div class="brand-summary-body">
      <div class="bs-main sf">380</div>
      <div class="bs-main-label">Chats WPP atendidos · prom. ~22/día</div>
      <div class="bs-row"><span class="bs-label">Días bandeja en 0</span><span class="bs-val amber">2</span></div>
      <div class="bs-row"><span class="bs-label">Pend. prom. al cierre</span><span class="bs-val red">82</span></div>
      <div class="bs-row"><span class="bs-label">Mails respondidos</span><span class="bs-val">40 · dato desde 18/08</span></div>
      <div class="bs-row"><span class="bs-label">Tópico principal WPP</span><span class="bs-val">Envíos / Seguimiento</span></div>
      <div class="bs-row"><span class="bs-label">Tickets Burbuxa</span><span class="bs-val sf">131 <small style="color:var(--text3)">(desde 18/08)</small></span></div>
      <div class="bs-row"><span class="bs-label">IA resuelve sola</span><span class="bs-val amber">sin dato completo</span></div>
    </div>
  </div>
